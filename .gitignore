# cache/ is disposable, TTL'd data re-downloaded/re-fetched from Steam and the ByMykel/CSGO-API
# feed (see src/data.py, src/steam_prices.py, src/thirdparty_prices.py) -- never worth tracking.
cache/

# Python
__pycache__/
*.pyc

# subagent-driven-development scratch: per-plan briefs, reports, review packages, progress ledger
.superpowers/

# React + Vite frontend: node_modules is huge/regenerable (npm install), dist is a build
# artifact rebuilt by `npm run build` and served by web/server.py. Source under frontend/src
# IS tracked. (data/inventory_cache.json and the various data/*.jsonl exceptions this section
# used to list are now redundant -- see the blanket /data/ ignore below.)
frontend/node_modules/
frontend/dist/
frontend/.vite/

# tools/mae_parity.py's per-son CV-MAE baseline -- machine-local, re-baselined on `main`
tools/.mae_baseline.json

# data/ is NO LONGER tracked in git (was, until 2026-09-03) -- it held accumulated outcomes,
# price history, the sim-population logs, and trained ML models, and grew to ~330 MB tracked
# (~99% of this repo's git history). It stays entirely local now. Carry it between machines
# with the project's own `export-data` / `import-data` (src/data_archive.py) or the dedicated
# backup repo, NOT git. The whole directory is ignored; a .gitkeep keeps the folder on clone.
/data/
!/data/.gitkeep

# Archives from `export-data`/`backup_engine.py` land in the project root by default -- keep
# them out of git unless you specifically want to check one in as a point-in-time backup (in
# which case, `git add -f` that one file). Matches both the CLI export-data naming
# (data-archive-*.zip) and backup_engine.py's actual naming (archive_TIMESTAMP_*.zip, which this
# pattern previously didn't cover -- that mismatch is why ~31 backup archives ended up committed
# to this repo's history instead of being caught here).
/data-archive-*.zip
/archive_*.zip

# Safety net for src/sheets_export.py's Google service-account key: it should live OUTSIDE this
# repo entirely (see that module's docstring -- data/ gets zipped and auto-pushed to GitHub by
# backup_engine.py), but this catches it anywhere in the tree if one ever ends up here anyway.
*service-account*.json
*serviceaccount*.json
*-key.json
credentials.json

# Personal watch-mode setup cheat-sheet + launcher (src/watch_loop.py, src/alerts.py) -- holds
# the private ntfy topic name (and, once filled in, Google Sheets paths). Local-only, never
# pushed to GitHub even though this repo's own auto-backup would otherwise happily zip it up.
/SETUP_NOTES.md
/run_watch.bat

# Dashboard "Connections" settings (src/connections_config.py): CSFloat API key + NTFY topic.
# Deliberately kept OUTSIDE data/ and out of git for the same reason as SETUP_NOTES.md above --
# data/ is tracked and auto-backed-up wholesale, so any secret has to live here instead.
/connections.local.json
